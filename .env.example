# JobFlow secrets.
#
# Copy this file to `.env` and fill in your key:
#
#     cp .env.example .env          (Windows: copy .env.example .env)
#
# `.env` is gitignored, so the key never reaches the repository. Nothing
# here is required unless you use --use-llm.

# Your OpenAI API key, from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Optional: point at any OpenAI-compatible endpoint instead, such as a local
# model served by Ollama or LM Studio. Leave commented out for OpenAI itself.
# OPENAI_BASE_URL=http://localhost:11434/v1
